{
    "version": 9,
    "configurePresets": [
        {
            "name": "debug",
            "binaryDir": "build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "ENABLE_TESTING": true
            }
        },
        {
            "name": "Release",
            "inherits": [
                "debug"
            ],
            "binaryDir": "build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        }
    ]
}