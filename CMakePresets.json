{
    "version": 9,
    "configurePresets": [
        {
            "name": "debug",
            "binaryDir": "build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "XCMIXIN_BUILD_EXAMPLES": false,
                "BUILD_EXAMPLES": true,
                "BUILD_TESTING": true
            }
        },
        {
            "name": "release",
            "inherits": [
                "debug"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "BUILD_EXAMPLES": false,
                "BUILD_TESTING": false
            }
        }
    ]
}